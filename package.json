{
  "name": "@da/editor",
  "version": "0.0.1",
  "description": "A React rich-text editor component.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/da-editor.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/is-hotkey": "^0.1.10",
    "@types/node": "^26.4.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0"
  },
  "keywords": [
    "react",
    "editor",
    "rich-text",
    "wysiwyg"
  ],
  "dependencies": {
    "frimousse": "^0.3.0",
    "is-hotkey": "^0.2.0",
    "mammoth": "^1.12.2",
    "prismjs": "^1.30.0",
    "react-colorful": "^5.8.1",
    "slate": "^0.126.2",
    "slate-dom": "^0.126.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.126.4"
  }
}
